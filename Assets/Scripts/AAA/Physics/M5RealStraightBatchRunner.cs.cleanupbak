using System;
using System.Collections.Generic;
using System.IO;
using UnityEngine;

namespace VR147.AAA.Physics
{
    public sealed class M5RealStraightBatchRunner : MonoBehaviour
    {
        private const int TotalShots = 10;
        private const int BaselineShots = 5;
        private const float StartDelay = 1.0f;
        private const float ResetDelay = 0.25f;
        private const float ShotTimeout = 20.0f;
        private const float CalibrationPower = 0.5f;

        private readonly List<float> distances = new();
        private readonly List<float> peakSpeeds = new();
        private Rigidbody cueBall;
        private M5ShotLifecycle lifecycle;
        private SnookerCueController cue;
        private Vector3 startPosition;
        private float shotElapsed;
        private float peakSpeed;
        private float nextActionTime;
        private int shotIndex;
        private bool waitingForSettlement;
        private bool complete;

        private void Start()
        {
            var setup = FindFirstObjectByType<SnookerPhysicsSetup>();
            if (setup == null)
            {
                Debug.LogError("[M5 REAL] SnookerPhysicsSetup missing; batch blocked.");
                enabled = false; return;
            }
            setup.EnsurePhysics();
            cue = FindFirstObjectByType<SnookerCueController>();
            lifecycle = FindFirstObjectByType<M5ShotLifecycle>();
            var tracker = FindFirstObjectByType<SnookerBallTracker>();
            var info = tracker != null ? tracker.FindBall("White_CueBall") : null;
            if (info == null && tracker != null)
            {
                foreach (var candidate in tracker.Balls)
                    if (candidate != null && candidate.points == 0 && candidate.transform != null) { info = candidate; break; }
            }
            var authoritativeCue = GameObject.Find("Sphere.009");
            cueBall = authoritativeCue != null
                ? authoritativeCue.GetComponent<Rigidbody>()
                : (info?.transform != null ? info.transform.GetComponent<Rigidbody>() : null);
            if (cueBall == null)
            {
                var fallback = GameObject.Find("Sphere.009");
                cueBall = fallback != null ? fallback.GetComponent<Rigidbody>() : null;
            }
            if (cue == null || lifecycle == null || cueBall == null)
            {
                Debug.LogError("[M5 REAL] Missing cue/lifecycle/cueBall; batch blocked.");
                enabled = false;
                return;
            }
            if (!CalibrationEnvironmentIsolator.Isolate(cueBall, setup))
            {
                Debug.LogError("[M5 REAL] Calibration environment isolation failed; batch blocked.");
                enabled = false;
                return;
            }
            Vector3 safeStart = cueBall.position;
            safeStart.x = setup.TableBounds.center.x;
            safeStart.z = setup.TableBounds.center.z - 1.0f;
            safeStart.y = setup.SurfaceTopY + 0.02725f;
            cueBall.isKinematic = false;
            cueBall.detectCollisions = true;
            cueBall.position = safeStart;
            cueBall.linearVelocity = Vector3.zero;
            cueBall.angularVelocity = Vector3.zero;
            UnityEngine.Physics.SyncTransforms();
            startPosition = safeStart;
            lifecycle.ShotSettled += OnShotSettled;
            nextActionTime = Time.time + StartDelay;
            Debug.Log("[M5 REAL] 10-shot REAL Straight batch armed: baseline=5 regression=5.");
        }

        private void Update()
        {
            if (complete || cueBall == null) return;
            peakSpeed = Mathf.Max(peakSpeed, cueBall.linearVelocity.magnitude);
            if (waitingForSettlement)
            {
                shotElapsed += Time.deltaTime;
                if (shotElapsed > ShotTimeout)
                {
                    Debug.LogError("[M5 REAL] Shot timeout; batch aborted.");
                    enabled = false;
                }
                return;
            }
            if (Time.time < nextActionTime) return;
            FireNextShot();
        }
        private void FireNextShot()
        {
            ResetCueBall();
            peakSpeed = 0f;
            shotElapsed = 0f;
            waitingForSettlement = false;
            Debug.Log($"[M5 REAL] FIRE {shotIndex + 1}/{TotalShots} REAL Straight via SnookerCueController.ShootAt({CalibrationPower:F2}).");
            Vector3 aimPoint = cueBall.position + Vector3.forward;
            cue.ShootAt(aimPoint, CalibrationPower);
            waitingForSettlement = true;
        }

        private void OnShotSettled()
        {
            if (!waitingForSettlement || cueBall == null) return;
            float distance = Vector2.Distance(
                new Vector2(startPosition.x, startPosition.z),
                new Vector2(cueBall.position.x, cueBall.position.z));
            distances.Add(distance);
            peakSpeeds.Add(peakSpeed);
            shotIndex++;
            waitingForSettlement = false;
            Debug.Log($"[M5 REAL] SETTLED {shotIndex}/{TotalShots} distance={distance:F9} peakSpeed={peakSpeed:F9}");
            if (shotIndex >= TotalShots)
            {
                Persist();
                complete = true;
                lifecycle.ShotSettled -= OnShotSettled;
#if UNITY_EDITOR
                UnityEditor.EditorApplication.isPlaying = false;
#endif
                return;
            }
            nextActionTime = Time.time + ResetDelay;
        }

        private void ResetCueBall()
        {
            cueBall.isKinematic = false;
            cueBall.detectCollisions = true;
            cueBall.WakeUp();
            Debug.Log($"[M5 REAL] RESET cue={cueBall.name} isKinematic={cueBall.isKinematic} active={cueBall.gameObject.activeInHierarchy} detect={cueBall.detectCollisions}");
            cueBall.position = startPosition;
            cueBall.rotation = Quaternion.identity;
            cueBall.linearVelocity = Vector3.zero;
            cueBall.angularVelocity = Vector3.zero;
            UnityEngine.Physics.SyncTransforms();
            lifecycle.ResetToIdle();
        }

        private void Persist()
        {
            string root = Directory.GetParent(Application.dataPath).FullName;
            string dir = Path.Combine(root, "Assets/AAA/PhysicsCalibration/RuntimeMeasurements");
            Directory.CreateDirectory(dir);
            string stamp = DateTime.UtcNow.ToString("O");
            Write(Path.Combine(dir, "straight_runtime_measurements.json"), stamp, distances.GetRange(0, BaselineShots), peakSpeeds.GetRange(0, BaselineShots));
            Write(Path.Combine(dir, "straight_regression_measurements.json"), stamp, distances.GetRange(BaselineShots, BaselineShots), peakSpeeds.GetRange(BaselineShots, BaselineShots));
            File.WriteAllText(Path.Combine(root, "Assets/AAA/PhysicsCalibration/.m5_straight_ready"), "ready");
            Debug.Log("[M5 REAL] PERSISTED 5 baseline + 5 regression REAL measurements.");
        }

        private static void Write(string path, string stamp, List<float> d, List<float> s)
        {
            var payload = new Measurement { timestampUtc = stamp, caseType = "Straight", repetitions = d.Count, measuredDistance = d.ToArray(), measuredPeakSpeed = s.ToArray() };
            File.WriteAllText(path, JsonUtility.ToJson(payload, true));
        }

        [Serializable]
        private sealed class Measurement
        {
            public string timestampUtc;
            public string caseType;
            public int repetitions;
            public float[] measuredDistance;
            public float[] measuredPeakSpeed;
        }
    }
}